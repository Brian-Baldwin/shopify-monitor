# Store Configuration (uses the store's public products.json endpoints,
# no Shopify Storefront API token or admin access required)
STORE_URL=https://princedist.com

# Monitoring Configuration
MONITOR_INTERVAL_MINUTES=10

# Discord Notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Database
DATABASE_PATH=./data/pokemon_monitor.db

# Optional: Proxy list for rate-limit (429) fallback
# When a request gets a 429, the monitor retries through the next proxy
# in this list instead of just backing off. Leave unset to disable.
#
# Comma or newline separated entries, each in one of these formats:
#   host:port
#   host:port:username:password
#   http://username:password@host:port
# PROXY_LIST=1.2.3.4:8000:user1:pass1,5.6.7.8:8000:user2:pass2

# Optional: alternative to PROXY_LIST - a file with one proxy per line
# (lines starting with # are ignored)
# PROXY_LIST_FILE=./proxies.txt

